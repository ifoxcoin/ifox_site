@model ifox_site.Models.SendMailViewModel
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@{
    ViewData["Title"] = "Contact IFOX Solutions | IT Consulting & Dynamics 365 Experts";
}

@section Head {
    <meta name="description" content="Get in touch with IFOX Solutions for IT consulting, Dynamics 365 CRM services, web development, and managed IT support. Contact us for inquiries, support, or project discussions in the US and UK.">
    <link rel="canonical" href="https://www.ifox.co.in/contact-us" />
    <!-- ===== OPEN GRAPH (Facebook, LinkedIn) ===== -->
    <meta property="og:title" content="Contact IFOX Solutions">
    <meta property="og:description" content="Reach out to IFOX for IT consulting, Dynamics 365 CRM, web development, and IT support services.">
    <meta property="og:url" content="https://www.ifox.co.in/contact-us">
    <meta property="og:type" content="website">
    <meta property="og:image" content="https://www.ifox.co.in/images/contact-ifox.jpg">
    <!-- ===== TWITTER CARD ===== -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Contact IFOX Solutions">
    <meta name="twitter:description" content="Get in touch with IFOX for IT consulting, Dynamics 365 CRM, and digital solutions.">
    <meta name="twitter:image" content="https://www.ifox.co.in/images/contact-ifox.jpg">
    <meta name="twitter:url" content="https://www.ifox.co.in/contact-us">
    <meta name="twitter:site" content="@@IFOXSolutions">
}

<!-- ======= Contact Section ======= -->
<section id="contact" class="contact">
    <div class="container" data-aos="fade-up">
        <div class="section-title">
            <h2>Contact Us</h2>
            <p>Have any idea or project for in your mind call us or schedule a appointment. Our representative will reply you shortly.</p>
        </div>
        <div class="row">
            <div class="col-lg-5 d-flex align-items-stretch">
                <div class="info">
                    <div class="email">
                        <i class="bi bi-envelope logomargin"></i>
                        <h5>Email:</h5>
                        <a href="mailto:info@ifox.co.in">
                            info@ifox.co.in
                        </a><br />
                        <a style="padding-left:60px" href="mailto:hr@ifox.co.in">
                            hr@ifox.co.in
                        </a><br />
                        <a style="padding-left:60px" href="mailto:sales@ifox.co.in">
                            sales@ifox.co.in
                        </a>
                    </div>
                    <br />
                    <div class="phone">
                        <i class="bi bi-phone logomargin"></i>
                        <h5>Call:</h5>
                        <a href="tel:+919597 892 118">
                            +91 9488 718 218
                        </a>
                    </div>
                    <br />
                    <iframe src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d555.2192744687742!2d78.11907512397109!3d9.97692585281044!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e1!3m2!1sen!2sin!4v1779351962791!5m2!1sen!2sin" height="450" style="border:0;width:100%;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
                </div>
            </div>

            <div class="col-lg-7 mt-5 mt-lg-0 d-flex align-items-stretch">
                <form id="contact-form" asp-controller="Contact" asp-action="SendEmail" method="post" enctype="multipart/form-data" role="form" class="php-email-form" onsubmit="return validateAndSubmit()" novalidate>
                    <div class="row">
                        <div class="form-group col-md-6">
                            <label asp-for="@Model.Name">Your Name</label>
                            <input type="text" asp-for="@Model.Name" class="form-control" id="name" autocomplete="name" required>
                            <div class="custom-validation-message" id="nameErrorMessage" role="alert"></div>
                        </div>
                        <div class="form-group col-md-6">
                            <label asp-for="@Model.Email">Your Email</label>
                            <input type="email" asp-for="@Model.Email" class="form-control" id="email" autocomplete="email" required>
                            <div class="custom-validation-message" id="emailErrorMessage" role="alert"></div>
                        </div>
                    </div>
                    <div class="form-group">
                        <label asp-for="@Model.Subject">Subject</label>
                        <input type="text" asp-for="@Model.Subject" class="form-control" id="subject" maxlength="200" required>
                        <div class="custom-validation-message" id="subjectErrorMessage" role="alert"></div>
                    </div>
                    <div class="form-group">
                        <label asp-for="@Model.Contact">Contact No.</label>
                        <input type="tel" asp-for="@Model.Contact" class="form-control" id="Contact" autocomplete="tel" inputmode="tel" maxlength="25" required>
                        <div class="custom-validation-message" id="contactErrorMessage" role="alert"></div>
                    </div>
                    <div class="form-group">
                        <label asp-for="@Model.Attachments">Attachment</label>
                        <input type="file" asp-for="@Model.Attachments" style="height:100%" class="form-control" name="file" id="Attachments" accept=".pdf, .doc, .docx, .xls, .xlsx" onchange="validateFile()" />
                        <div class="file-validation-message" id="fileErrorMessage" style="display:none;"></div>
                    </div>
                    <div class="form-group">
                        <label asp-for="@Model.Message">Message</label>
                        <textarea class="form-control" asp-for="@Model.Message" id="message" rows="10" maxlength="5000"></textarea>
                    </div>
                    <div class="local-captcha">
                        <input type="checkbox" id="local-captcha" name="local-captcha" value="verified" />
                        <label for="local-captcha">I'm not a robot</label>
                    </div>
                    <div class="text-danger" id="captchaErrorMessage" role="alert" aria-live="polite"></div>
                    <div class="my-3">
                        <div class="loading">Loading</div>
                        <div class="error-message" id="formErrorMessage" style="display:none;"></div>
                        <div class="sent-message">Your message has been sent. Thank you!</div>
                    </div>
                    <div class="text-center">
                        <button type="submit">Send Message</button>
                    </div>
                </form>
            </div>

        </div>

    </div>
</section>
<!-- End Contact Section -->
<script>
    function validateAndSubmit() {
        var form = document.getElementById('contact-form');
        var errorMessage = document.getElementById('formErrorMessage');
        var fileErrorMessage = document.getElementById('fileErrorMessage');  // Get the attachment error message element
        var requiredFields = [
            { input: document.getElementById('name'), error: document.getElementById('nameErrorMessage'), requiredMessage: 'Please fill out this field.' },
            { input: document.getElementById('email'), error: document.getElementById('emailErrorMessage'), requiredMessage: 'Please fill out this field.', invalidMessage: 'Please enter a valid email address.' },
            { input: document.getElementById('subject'), error: document.getElementById('subjectErrorMessage'), requiredMessage: 'Please fill out this field.' },
            { input: document.getElementById('Contact'), error: document.getElementById('contactErrorMessage'), requiredMessage: 'Please fill out this field.', invalidMessage: 'Please enter a valid contact number.' }
        ];
        var firstInvalidField = null;
        var emailPattern = /^[^\s@@]+@@[^\s@@]+\.[^\s@@]+$/;
        var contactPattern = /^\+?[0-9][0-9\s().-]{6,24}$/;

        // Clear previous error messages
        errorMessage.style.display = 'none';
        fileErrorMessage.style.display = 'none';  // Hide the file error message on form submit
        requiredFields.forEach(function (field) {
            field.error.textContent = '';
            field.input.classList.remove('custom-validation-error');
            if (!field.input.value.trim()) {
                field.error.textContent = field.requiredMessage;
                field.input.classList.add('custom-validation-error');
                firstInvalidField = firstInvalidField || field.input;
            } else if (field.input.id === 'email' && !emailPattern.test(field.input.value.trim())) {
                field.error.textContent = field.invalidMessage;
                field.input.classList.add('custom-validation-error');
                firstInvalidField = firstInvalidField || field.input;
            } else if (field.input.id === 'Contact' && !contactPattern.test(field.input.value.trim())) {
                field.error.textContent = field.invalidMessage;
                field.input.classList.add('custom-validation-error');
                firstInvalidField = firstInvalidField || field.input;
            }
        });

        if (firstInvalidField) {
            firstInvalidField.focus();
            return false;
        }

        // Check if reCAPTCHA is completed
        if (!document.getElementById("local-captcha").checked) {
            document.getElementById("captchaErrorMessage").textContent = "Please confirm that you are not a robot.";
            return false;
        }

        // Check if the file is valid (can be added based on your file validation function)
        if (!validateFile()) {
            return false;  // Prevent form submission if file is invalid
        }

        return true; // Allow form submission
    }


</script>

<script>
    function validateFile() {
        var fileInput = document.getElementById('Attachments');
        var errorMessage = document.getElementById('fileErrorMessage');

        // If no file is selected, don't block submission on attachment validation.
        if (!fileInput.files || fileInput.files.length === 0) {
            errorMessage.style.display = 'none';
            return true;
        }

        var file = fileInput.files[0];

        // Reset error messages
        errorMessage.style.display = 'none';

        // Check file type (PDF, Word, Excel)
        var allowedTypes = ['application/pdf', 'application/msword', 'application/vnd.openxmlformats-officedocument.wordprocessingml.document', 'application/vnd.ms-excel', 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'];
        if (!allowedTypes.includes(file.type)) {
            errorMessage.innerHTML = 'Only PDF, Word, and Excel files are allowed.';
            errorMessage.style.display = 'block';
            return false;
        }

        // Check file size (5MB limit)
        var maxSize = 5 * 1024 * 1024; // 5MB in bytes
        if (file.size > maxSize) {
            errorMessage.innerHTML = 'File size must be below 5MB.';
            errorMessage.style.display = 'block';
            fileInput.value = '';
            return false;
        }

        // If everything is valid, hide the error message
        errorMessage.style.display = 'none';
        return true;
    }

</script>

