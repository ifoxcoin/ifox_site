@{
    ViewData["Title"] = "CRM Consulting";
}

<section style="background-image:url('/assets/img/hiredevelopers/her2.webp'); background-repeat:no-repeat; background-size:cover; background-position:center;" width="100%" height="300px">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="text-white pt-5 pb-5"><b>MICROSOFT DYNAMICS 365 CRM CONSULTING</b></h1>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-8" align="justify">
                <h3><b>Expert Dynamics 365 CRM Consulting</b></h3>
                <p>Dynamics 365 CRM consulting helps organizations plan, configure, improve, and manage CRM solutions around their business processes.</p>
                <ul class="list-unstyled">
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Business Process Analysis: Understand existing workflows and identify areas where Dynamics 365 can improve productivity.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> CRM Strategy: Define a clear implementation and optimization approach based on business requirements.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Solution Planning: Design CRM functionality, integrations, security, and user roles before development begins.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Customization Guidance: Recommend suitable forms, entities, dashboards, workflows, and business rules.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> User Adoption: Support users with training and guidance so the CRM solution is used effectively.</p>
                    </li>
                </ul>
            </div>
            <div class="col-lg-4 Imgborder">
                <div><img src="/assets/img/dynamics365/businesswoman-discussing-with-disabled-woman.webp" class="img-fluid text-start ms-0 mb-5 mt-3 me-3 p-3" alt="CRM Consulting" /></div>
                <div><img src="/assets/img/dynamics365/representation-user-experience-interface-design-computer.webp" class="img-fluid text-start ms-0 mb-5 mt-3 me-3 p-3" alt="CRM Consulting" /></div>
            </div>
        </div>
    </div>
</section>

<section id="call-to-action" class="call-to-action section dark-background">
    <img src="/assets/img/dynamics365/office2.webp" alt="">
    <div class="container">
        <div class="row aos-init aos-animate" data-aos="zoom-in" data-aos-delay="100">
            <div class="col-xl-9 text-center text-xl-start">
                <h3>Looking for Microsoft Dynamics 365 experts?</h3>
                <p>Set up a consultation right now.</p>
            </div>
            <div class="col-xl-3 cta-btn-container text-center">
                <a class="cta-btn align-middle" href="/contact">Get Started</a>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div><img src="/assets/img/dynamics365/representation-user-experience-interface-design-computer.webp" class="img-fluid text-start ms-0 mb-5 mt-3 me-3 p-3" alt="CRM Consulting" /></div>
            </div>
            <div class="col-lg-8 Imgborder" align="justify">
                <h3><b>How Dynamics 365 CRM Consulting Supports Business Growth</b></h3>
                <p>A well-planned CRM environment should remain useful as business requirements change.</p>
                <ul class="list-unstyled">
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Performance Review: Review the CRM environment and identify opportunities for improvement.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Integration Planning: Connect Dynamics 365 with relevant business systems and applications.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Data Management: Establish practical processes for maintaining accurate CRM data.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Security Planning: Align access and permissions with organizational responsibilities.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Continuous Improvement: Review business needs regularly and refine the CRM solution accordingly.</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="call-to-action" class="call-to-action section dark-background">
    <img src="/assets/img/dynamics365/office2.webp" alt="">
    <div class="container">
        <div class="row aos-init aos-animate" data-aos="zoom-in" data-aos-delay="100">
            <div class="col-xl-9 text-center text-xl-start">
                <h3>Need help with Microsoft Dynamics 365?</h3>
                <p>Talk to our experts about your requirements.</p>
            </div>
            <div class="col-xl-3 cta-btn-container text-center">
                <a class="cta-btn align-middle" href="/contact">Get Started</a>
            </div>
        </div>
    </div>
</section>
