<style>
    .ifox-achievements .achievement-card {
        min-height: 170px;
        padding: 1.5rem 1rem;
        color: #fff;
        background: #061f35;
        border: 1px solid rgba(93, 228, 255, .45);
        border-radius: .5rem;
        box-shadow: 0 10px 24px rgba(0, 5, 14, .28), inset 0 0 18px rgba(0, 170, 255, .04);
        transition: transform .3s ease, box-shadow .3s ease, border-color .3s ease;
    }

    .ifox-achievements .achievement-card:hover {
        border-color: #5de4ff;
        box-shadow: 0 16px 30px rgba(0, 5, 14, .38), 0 0 18px rgba(93, 228, 255, .22);
        transform: translateY(-6px);
    }

    .ifox-achievements .analytics-head {
        color: #ff672f;
    }

    .ifox-achievements .analytics-para {
        color: #fff;
    }

    @@media (prefers-reduced-motion: reduce) {
        .ifox-achievements .achievement-card {
            transition: none;
        }

        .ifox-achievements .achievement-card:hover {
            transform: none;
        }
    }
</style>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const achievements = document.querySelector('.ifox-achievements');
        const counters = achievements?.querySelectorAll('.analytics-head') ?? [];

        if (!achievements || !counters.length || !('IntersectionObserver' in window)) {
            return;
        }

        const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        let hasStarted = false;

        const animateCounter = (counter) => {
            const match = counter.textContent.trim().match(/(\d+)(\D*)/);
            if (!match) {
                return;
            }

            const target = Number(match[1]);
            const suffix = match[2];

            if (reducedMotion) {
                counter.textContent = `${target}${suffix}`;
                return;
            }

            const duration = 3000;
            const startTime = performance.now();

            counter.textContent = `0${suffix}`;

            const updateCounter = (currentTime) => {
                const progress = Math.min((currentTime - startTime) / duration, 1);
                const easedProgress = 1 - Math.pow(1 - progress, 3);
                counter.textContent = `${Math.floor(easedProgress * target)}${suffix}`;

                if (progress < 1) {
                    window.requestAnimationFrame(updateCounter);
                }
            };

            window.requestAnimationFrame(updateCounter);
        };

        const observer = new IntersectionObserver((entries) => {
            if (hasStarted || !entries.some(entry => entry.isIntersecting)) {
                return;
            }

            hasStarted = true;
            observer.disconnect();
            counters.forEach(animateCounter);
        }, { threshold: 0.25 });

        observer.observe(achievements);
    });
</script>

<!--END Achievements-->
