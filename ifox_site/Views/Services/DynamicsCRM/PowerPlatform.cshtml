@{
    ViewData["Title"] = "Power Platform";
}

<section style="background-image:url('/assets/img/hiredevelopers/her2.webp'); background-repeat:no-repeat; background-size:cover; background-position:center;" width="100%" height="300px">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center">
            <div class="col-lg-8">
                <h1 class="text-white pt-5 pb-5"><b>MICROSOFT POWER PLATFORM FOR DYNAMICS 365</b></h1>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-8" align="justify">
                <h3><b>Power Platform and Dynamics 365 Solutions</b></h3>
                <p>Microsoft Power Platform works alongside Dynamics 365 to support apps, automation, analytics, and low-code business solutions.</p>
                <ul class="list-unstyled">
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Power Apps: Build business applications around organizational data and processes.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Power Automate: Automate repetitive workflows, notifications, approvals, and connected processes.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Power BI: Create reports and dashboards from business data.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Dataverse: Use a structured data platform for connected business solutions.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> AI Capabilities: Explore intelligent assistance and automation for suitable business scenarios.</p>
                    </li>
                </ul>
            </div>
            <div class="col-lg-4 Imgborder">
                <div><img src="/assets/img/powerplatform/PowerPlatform.webp" class="img-fluid text-start ms-0 mb-5 mt-3 me-3 p-3" alt="Power Platform" /></div>
                <div><img src="/assets/img/powerplatform/PowerApps.webp" class="img-fluid text-start ms-0 mb-5 mt-3 me-3 p-3" alt="Power Platform" /></div>
            </div>
        </div>
    </div>
</section>

<section id="call-to-action" class="call-to-action section dark-background">
    <img src="/assets/img/dynamics365/office2.webp" alt="">
    <div class="container">
        <div class="row aos-init aos-animate" data-aos="zoom-in" data-aos-delay="100">
            <div class="col-xl-9 text-center text-xl-start">
                <h3>Looking for Microsoft Dynamics 365 experts?</h3>
                <p>Set up a consultation right now.</p>
            </div>
            <div class="col-xl-3 cta-btn-container text-center">
                <a class="cta-btn align-middle" href="/contact">Get Started</a>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div><img src="/assets/img/powerplatform/PowerApps.webp" class="img-fluid text-start ms-0 mb-5 mt-3 me-3 p-3" alt="Power Platform" /></div>
            </div>
            <div class="col-lg-8 Imgborder" align="justify">
                <h3><b>Connecting Dynamics 365 with the Power Platform</b></h3>
                <p>Combining Dynamics 365 with Power Platform services can create connected solutions across CRM, applications, automation, and analytics.</p>
                <ul class="list-unstyled">
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Connected Data: Use Dataverse to support connected business applications.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Workflow Automation: Reduce manual work by automating repetitive activities.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Business Applications: Extend CRM processes with Power Apps.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Analytics: Bring business data into Power BI reports and dashboards.</p>
                    </li>
                    <li>
                        <p><i class="bi bi-check2-circle color"></i> Scalable Solutions: Start with focused solutions and expand as requirements grow.</p>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section id="call-to-action" class="call-to-action section dark-background">
    <img src="/assets/img/dynamics365/office2.webp" alt="">
    <div class="container">
        <div class="row aos-init aos-animate" data-aos="zoom-in" data-aos-delay="100">
            <div class="col-xl-9 text-center text-xl-start">
                <h3>Need help with Microsoft Dynamics 365?</h3>
                <p>Talk to our experts about your requirements.</p>
            </div>
            <div class="col-xl-3 cta-btn-container text-center">
                <a class="cta-btn align-middle" href="/contact">Get Started</a>
            </div>
        </div>
    </div>
</section>
