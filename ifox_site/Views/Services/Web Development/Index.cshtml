@{
    ViewData["Title"] = "Web Development Services";
    ViewData["PageClass"] = "ifox-service-page ifox-web-development-page";
}

<style>
    body.ifox-web-development-page h1,
    body.ifox-web-development-page h2,
    body.ifox-web-development-page h3,
    body.ifox-web-development-page h4,
    body.ifox-web-development-page h4 a {
        color: #ff6b2c;
    }

    body.ifox-web-development-page .ifox-web-capabilities .icon-box {
        position: relative;
        overflow: visible;
        cursor: pointer;
        transition: border-color .25s ease, box-shadow .25s ease, transform .25s ease;
    }

    body.ifox-web-development-page .ifox-web-capabilities .icon-box > p {
        position: absolute;
        top: calc(100% - 8px);
        left: 12px;
        right: 12px;
        z-index: 20;
        margin: 0;
        padding: 14px 16px;
        border: 1px solid rgba(99, 221, 255, .55);
        border-radius: 8px;
        background: #03182a;
        box-shadow: 0 14px 30px rgba(0, 0, 0, .45);
        color: #b7d5e6 !important;
        opacity: 0;
        visibility: hidden;
        transform: translateY(8px);
        transition: opacity .25s ease, visibility .25s ease, transform .25s ease;
        pointer-events: none;
    }

    body.ifox-web-development-page .ifox-web-capabilities .icon-box h4,
    body.ifox-web-development-page .ifox-web-capabilities .icon-box h4 a {
        position: relative;
        z-index: 1000 !important;
        pointer-events: auto !important;
    }

    body.ifox-web-development-page .ifox-web-capabilities .icon-box h4 a {
        display: inline-block;
        cursor: pointer;
    }

    body.ifox-web-development-page .ifox-web-capabilities .icon-box:hover,
    body.ifox-web-development-page .ifox-web-capabilities .icon-box:focus-within {
        z-index: 30;
        border-color: #63ddff;
        box-shadow: 0 0 22px rgba(99, 221, 255, .18);
        transform: translateY(-3px);
    }

    body.ifox-web-development-page .ifox-web-capabilities .icon-box:hover > p,
    body.ifox-web-development-page .ifox-web-capabilities .icon-box:focus-within > p {
        opacity: 1;
        visibility: visible;
        transform: translateY(0);
    }

    @@media (max-width: 767px) {
        body.ifox-web-development-page .ifox-web-capabilities .icon-box > p {
            position: static;
            margin-top: 16px;
            opacity: 1;
            visibility: visible;
            transform: none;
        }
    }
</style>

<section class="ifox-service-hero" style="background-image:url('/assets/img/hiredevelopers/her2.webp'); background-repeat:no-repeat; background-size:cover; background-position:center;">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center">
            <div class="col-lg-8 mt-5">
                <h1 class="text-white text-start pt-5 pb-3"><b>WEB DEVELOPMENT SERVICES</b></h1>
                <p class="text-white pb-4">Design and build scalable websites, portals, and web applications for modern businesses.</p>
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row align-items-center">
            <div class="col-lg-12" align="justify">
