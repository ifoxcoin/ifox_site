<section style="background-image:url('/assets/img/hiredevelopers/her2.webp'); background-repeat: no-repeat; background-size: cover; background-position: center; " width="100%" height="300px">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center">
            <div class="col-lg-6">
                <div>
                    <h1 class="text-white pt-5 pb-5">PRODUCT STRATEGY & VISION</h1>
                </div>
            </div>
            <div class="col-lg-7 text-center">
                @*  <img src="~/assets/img/hiredevelopers/DevImg.png" width="60%" height="60%" />*@
            </div>
