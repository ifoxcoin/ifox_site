    <script>
        document.addEventListener("DOMContentLoaded", function () {

            /* =========================================================
               IFOX MEGA MENU
               SERVICES
               INDUSTRIES
               HIRE DEVELOPERS
               ========================================================= */

            const megaItems =
                document.querySelectorAll(".ifox-has-mega");

            if (!megaItems.length) {
                return;
            }


            /* =========================================================
               CLOSE ALL MENUS
               ========================================================= */

            function closeAllMegaMenus() {

                megaItems.forEach(function (item) {

                    item.classList.remove("services-open");

                });

            }


            /* =========================================================
               INITIALIZE EACH MENU
               ========================================================= */

            megaItems.forEach(function (megaItem) {

                const trigger =
                    megaItem.querySelector(".ifox-dropdown-trigger");

                const megaMenu =
                    megaItem.querySelector(".ifox-mega-menu");


                /* -----------------------------------------------------
                   SAFETY CHECK
                   ----------------------------------------------------- */

                if (!trigger || !megaMenu) {

                    console.warn(
                        "IFOX Mega Menu missing:",
                        megaItem
                    );

                    return;
                }


                /* =====================================================
                   TRIGGER CLICK
                   ===================================================== */

                trigger.addEventListener("click", function (event) {

                    event.preventDefault();
                    event.stopPropagation();

                    const isCurrentlyOpen =
                        megaItem.classList.contains("services-open");


                    /* Close every menu */
                    closeAllMegaMenus();


                    /* Open only clicked menu */
                    if (!isCurrentlyOpen) {

                        megaItem.classList.add("services-open");

                    }

                });


                /* =====================================================
                   MEGA MENU CLICK
                   ===================================================== */

                megaMenu.addEventListener("click", function (event) {

                    /*
                     * Do NOT close the menu when clicking inside it.
                     */

                    event.stopPropagation();

                });


                /* =====================================================
                   CATEGORY TABS
                   ===================================================== */

                const categories =
                    megaItem.querySelectorAll(
                        ".ifox-mega-category"
                    );


                const panels =
                    megaItem.querySelectorAll(
                        ".ifox-service-panel"
                    );


                categories.forEach(function (category) {

                    category.addEventListener(
                        "click",
                        function (event) {

                            event.preventDefault();
                            event.stopPropagation();


                            const tab =
                                this.getAttribute("data-tab");


                            if (!tab) {
                                return;
                            }


                            /* -----------------------------------------
                               REMOVE ACTIVE CATEGORY
                               ----------------------------------------- */

                            categories.forEach(function (item) {

                                item.classList.remove("active");

                            });


                            /* -----------------------------------------
                               REMOVE ACTIVE PANELS
                               ----------------------------------------- */

                            panels.forEach(function (panel) {

                                panel.classList.remove("active");

                            });


                            /* -----------------------------------------
                               ACTIVATE CATEGORY
                               ----------------------------------------- */

                            this.classList.add("active");


                            /* -----------------------------------------
                               FIND PANEL
                               ----------------------------------------- */

                            const selectedPanel =
                                megaItem.querySelector(
                                    '.ifox-service-panel[data-panel="' +
                                    tab +
                                    '"]'
                                );


                            /* -----------------------------------------
                               ACTIVATE PANEL
                               ----------------------------------------- */

                            if (selectedPanel) {

                                selectedPanel.classList.add("active");

                            }

                        }
                    );

                });


                /* =====================================================
                   DEFAULT ACTIVE TAB
                   ===================================================== */

                const activeCategory =
                    megaItem.querySelector(
                        ".ifox-mega-category.active"
                    );


                if (activeCategory) {

                    const firstTab =
                        activeCategory.getAttribute("data-tab");


                    panels.forEach(function (panel) {

                        panel.classList.remove("active");

                    });


                    if (firstTab) {

                        const firstPanel =
                            megaItem.querySelector(
                                '.ifox-service-panel[data-panel="' +
                                firstTab +
                                '"]'
                            );


                        if (firstPanel) {

                            firstPanel.classList.add("active");

                        }

                    }

                }

            });


            /* =========================================================
               CLICK OUTSIDE
               ========================================================= */

            document.addEventListener(
                "click",
                function (event) {

                    /*
                     * If the click is outside ALL mega menu items,
                     * close everything.
                     */

                    const clickedInsideMega =
                        event.target.closest(".ifox-has-mega");


                    if (!clickedInsideMega) {

                        closeAllMegaMenus();

                    }

                },
                false
            );


            /* =========================================================
               ESCAPE KEY
               ========================================================= */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        closeAllMegaMenus();

                    }

                }
            );


            /* =========================================================
               DEBUG
               ========================================================= */

            console.log(
                "IFOX Mega Menu initialized:",
                megaItems.length,
                "menus"
            );

        });
    </script>
