@{
    ViewData["Title"] = ViewData["IndustryTitle"];
    var items = ViewData["IndustryItems"] as string[][] ?? Array.Empty<string[]>();
}

<section class="product-category-landing">
    <div class="container">
        <p class="product-category-landing__eyebrow">iFOX INDUSTRY SOLUTIONS</p>
        <h1>@ViewData["IndustryTitle"]</h1>
        <p class="product-category-landing__intro">@ViewData["IndustryDescription"]</p>
        <div class="product-category-landing__grid">
            @foreach (var item in items)
            {
                <a href="@item[0]"><strong>@item[1]</strong><span>@item[2]</span></a>
            }
        </div>
    </div>
</section>
