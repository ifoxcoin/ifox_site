@{
    ViewData["Title"] = ViewData["IndustryTitle"] + " | IFOX";
    ViewData["PageClass"] = "ifox-industry-overview-page";
    var items = ViewData["IndustryItems"] as string[][] ?? Array.Empty<string[]>();
    var industryTitle = ViewData["IndustryTitle"]?.ToString() ?? "Industry Solutions";
    var industryDescription = ViewData["IndustryDescription"]?.ToString() ?? string.Empty;
}
<style>
    body.ifox-industry-overview-page #main,
    body.ifox-industry-overview-page #main > section {
        color: #d9efff;
        background: #020b17;
    }

    body.ifox-industry-overview-page h1,
    body.ifox-industry-overview-page h2,
    body.ifox-industry-overview-page h3,
    body.ifox-industry-overview-page h4,
    body.ifox-industry-overview-page h4 a {
        color: #ff6b2c;
    }

    body.ifox-industry-overview-page p,
    body.ifox-industry-overview-page li {
        color: #b7d5e6;
    }

    body.ifox-industry-overview-page .icon-box {
        height: 100%;
        border: 1px solid rgba(99, 221, 255, .25);
        background: rgba(3, 24, 42, .55);
    }

    body.ifox-industry-overview-page #call-to-action,
    body.ifox-industry-overview-page #call-to-action::before {
        background: #020b17 !important;
        background-image: none !important;
    }

    body.ifox-industry-overview-page section.ifox-content-right .row {
        justify-content: flex-end;
    }

    body.ifox-industry-overview-page .ifox-industry-overview-image {
        max-width: 85%;
    }

    @@media (max-width: 767px) {
        body.ifox-industry-overview-page section.ifox-content-right .row {
            justify-content: flex-start;
        }
    }
</style>

<section style="background:#020b17;">
    <div class="container" data-aos="fade-up">
        <div class="row align-items-center">
            <div class="col-lg-8 mt-5">
                <h1 class="text-start pt-3 pb-3"><b>@industryTitle</b></h1>
                <p class="pb-4">@industryDescription</p>
            </div>
            <div class="col-lg-4 text-center">
                <img src="~/assets/img/industries-overview.webp" class="img-fluid ifox-industry-overview-image" alt="Industries overview" />
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
                <div class="col-lg-8 overview-content-column" align="justify">
                <h2><b>Solutions That Reflect How Your Industry Works</b></h2>
                <p>
                    Technology creates the greatest value when it fits the realities of the people using it. We take time to understand your workflows, compliance expectations, customer journeys, operational systems, and the information your teams need every day. This helps us recommend improvements that are practical, measurable, and appropriate for your organization.
                </p>
                <p>
                    Whether your priority is improving service delivery, connecting locations, automating administration, or making better decisions from data, our team can help you move from disconnected processes to a more coordinated digital operation.
                </p>
                <ul class="list-unstyled">
                    <li><p><i class="bi bi-check2-circle color"></i> Industry-aware discovery that considers regulations, roles, processes, and customer expectations.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Connected platforms that reduce duplicated information and improve collaboration.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Dashboards and reporting that turn operational data into useful decisions.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Flexible solutions that can adapt as your organization, market, and service needs change.</p></li>
                </ul>
            </div>
            <div class="col-lg-4 text-center align-self-center">
                <img src="~/assets/img/industries-overview1.webp" class="img-fluid ifox-industry-overview-image" alt="Industry solutions" />
            </div>
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="row">
                <div class="col-lg-8 overview-content-column" align="justify">
                <h2><b>Secure Growth Through Continuous Improvement</b></h2>
                <p>
                    Industry solutions need to remain dependable after launch. We support organizations with testing, training, adoption planning, monitoring, and improvement cycles that keep technology aligned with real-world use. Feedback from teams and customers helps identify what should be simplified, automated, or enhanced next.
                </p>
                <p>
                    Our delivery approach balances immediate improvements with a longer-term technology roadmap. This allows you to make progress in manageable stages while protecting data, reducing disruption, and building a foundation for future innovation.
                </p>
                <ul class="list-unstyled">
                    <li><p><i class="bi bi-check2-circle color"></i> Phased delivery that makes priorities, outcomes, and progress visible.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Security, permissions, backup, and data-quality practices built into the solution.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Training and adoption support that helps teams gain value from new capabilities.</p></li>
                </ul>
            </div>
            <div class="col-lg-4 text-center align-self-center">
                <img src="~/assets/img/industries-overview2.webp" class="img-fluid ifox-industry-overview-image" alt="Industry growth solutions" />
            </div>
        </div>
    </div>
</section>

<section class="ifox-content-right">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 text-center align-self-center">
                <img src="~/assets/img/industries-overview3.webp" class="img-fluid ifox-industry-overview-image" alt="Industry technology solutions" />
            </div>
                <div class="col-lg-8 overview-content-column" align="justify">
                <h2><b>Technology Designed Around Your Industry</b></h2>
                <p>
                    Every industry has its own customers, regulations, workflows, and operational priorities. IFOX helps organizations use technology to simplify day-to-day work, connect important information, and create better experiences for the people they serve.
                </p>
                <p>
                    Our industry solutions combine practical software development, connected data, automation, and secure integrations. We begin with your business objectives and design solutions that can support current operations while remaining flexible as your organization grows.
                </p>
                <ul class="list-unstyled">
                    <li><p><i class="bi bi-check2-circle color"></i> Understand industry workflows and identify opportunities for improvement.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Connect teams, customers, partners, and operational information.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Build secure and scalable platforms that support long-term growth.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Improve visibility with dashboards, reporting, automation, and accurate data.</p></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="ifox-content-right">
    <div class="container">
        <div class="row">
            <div class="col-lg-4 text-center align-self-center">
                <img src="~/assets/img/industries-overview4.webp" class="img-fluid ifox-industry-overview-image" alt="Industry delivery solutions" />
            </div>
            <div class="col-lg-8 overview-content-column" align="justify">
                <h2><b>A Practical Path from Requirements to Results</b></h2>
                <p>
                    Successful industry technology projects require more than a collection of features. Our team works with stakeholders to understand the current environment, define priorities, plan integrations, and deliver improvements in manageable stages. This approach helps reduce disruption and gives your organization a clear way to measure progress.
                </p>
                <ul class="list-unstyled">
                    <li><p><i class="bi bi-check2-circle color"></i> Discovery, process mapping, and solution architecture.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> User-focused design and iterative development.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Security, testing, data quality, and integration planning.</p></li>
                    <li><p><i class="bi bi-check2-circle color"></i> Deployment, training, monitoring, and continuous support.</p></li>
                </ul>
            </div>
        </div>
    </div>
</section>

<section class="ifox-overview-capabilities">
    <div class="container">
        <div class="section-title text-center">
            <h2>@industryTitle Capabilities</h2>
            <p>Explore the solutions we provide for organizations in this industry.</p>
        </div>
        <div class="row">
            @foreach (var item in items)
            {
                <div class="col-lg-4 col-md-6 d-flex align-items-stretch mb-4">
                    <div class="icon-box w-100">
                        <div class="icon"><i class="bx bx-right-arrow-alt"></i></div>
                        <h4><a href="@item[0]">@item[1]</a></h4>
                        <p>@item[2]</p>
                    </div>
                </div>
            }
        </div>
    </div>
</section>

<section>
    <div class="container">
        <div class="section-title text-center">
            <h2>How We Help Organizations Move Forward</h2>
            <p>From planning to ongoing improvement, our approach keeps technology connected to measurable business outcomes.</p>
        </div>
        <div class="row">
            <div class="col-lg-4 mb-4">
                <div class="icon-box h-100">
                    <h4>Improve Visibility</h4>
                    <p>Bring operational information together so leaders and teams can make decisions using accurate, timely, and accessible data.</p>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="icon-box h-100">
                    <h4>Increase Efficiency</h4>
                    <p>Reduce repetitive work with connected workflows, automation, self-service tools, and applications that fit how your teams operate.</p>
                </div>
            </div>
            <div class="col-lg-4 mb-4">
                <div class="icon-box h-100">
                    <h4>Create Better Experiences</h4>
                    <p>Make it easier for customers, employees, students, patients, partners, or citizens to access services and complete important tasks.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="call-to-action" class="call-to-action section dark-background">
    <div class="container">
        <div class="row aos-init aos-animate" data-aos="zoom-in">
            <div class="col-xl-9 text-center text-xl-start">
                <h3>Ready to improve your @industryTitle operations?</h3>
                <p>Talk to our industry technology experts about your goals.</p>
            </div>
            <div class="col-xl-3 cta-btn-container text-center">
                <a class="cta-btn align-middle" href="/contact">Get Started</a>
            </div>
        </div>
    </div>
</section>
