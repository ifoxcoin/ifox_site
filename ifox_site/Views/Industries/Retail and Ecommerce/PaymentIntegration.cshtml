<!-- Challenges and Customization -->
<section>
    <div class="container">
        <div class="row">
            <div class="col-lg-4">
                <div><img src="~/assets/img/dynamics365/Developer2.webp" class="img-fluid text-start ms-0 mb-5 me-3 p-3" alt="Payment Integration" /></div>
